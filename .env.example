# Anthropic API key created for API access in the Anthropic Console
ANTHROPIC_API_KEY=

# A Claude model that supports structured outputs
ANTHROPIC_MODEL=

# Optional generation ceiling. Leave blank to use the project default.
ANTHROPIC_MAX_TOKENS=

# Comma-separated browser origins allowed to call the API during local development
MOSAIC_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000