# Azure OpenAI endpoint including /openai/v1/
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE-NAME.openai.azure.com/openai/v1/

# Azure model deployment name, not merely the underlying model name
AZURE_OPENAI_CHAT_DEPLOYMENT=YOUR-DEPLOYMENT-NAME

# Comma-separated browser origins allowed to call the API during local development
MOSAIC_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000